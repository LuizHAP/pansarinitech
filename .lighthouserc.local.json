{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3001/",
        "http://localhost:3001/now",
        "http://localhost:3001/projects",
        "http://localhost:3001/blog",
        "http://localhost:3001/blog/building-this-portfolio",
        "http://localhost:3001/projects/uaubox-design-system",
        "http://localhost:3001/projects/machinery-mobile-first"
      ],
      "settings": {
        "skipAudits": [
          "installable-manifest",
          "service-worker",
          "splash-screen",
          "themed-omnibox",
          "content-width",
          "apple-touch-icon",
          "maskable-icon"
        ]
      },
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.5 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": "off",
        "largest-contentful-paint": "warn",
        "interactive": "warn",
        "mainthread-work-breakdown": "warn",
        "bootup-time": "warn",
        "dom-size": "warn",
        "max-potential-fid": "warn",
        "legacy-javascript-insight": "off",
        "network-dependency-tree-insight": "off",
        "image-delivery-insight": "off",
        "render-blocking-insight": "off",
        "document-latency-insight": "off",
        "forced-reflow-insight": "off",
        "unused-javascript": ["warn", { "maxLength": 5 }],
        "uses-long-cache-ttl": "off",
        "render-blocking-resources": "off",
        "legacy-javascript": "off",
        "redirects": "off",
        "is-crawlable": "off",
        "errors-in-console": "off",
        "robots-txt": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
