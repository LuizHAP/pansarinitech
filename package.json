{
  "name": "pansarinitech",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/extract-skill-icons.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "verify:static": "node scripts/check-static-rendering.mjs",
    "verify:data": "tsx scripts/check-data.ts",
    "verify:projects": "node scripts/check-mdx-content.mjs --kind=projects",
    "verify:posts": "node scripts/check-mdx-content.mjs --kind=posts",
    "verify:mdx-content": "node scripts/check-mdx-content.mjs --kind=all",
    "verify:no-highlighter": "node scripts/verify-no-highlighter.mjs",
    "verify:message-length": "node scripts/check-message-length.mjs",
    "verify:metadata": "node scripts/verify-metadata.mjs",
    "verify:ci-safety": "node scripts/check-ci-safety.mjs",
    "analyze": "ANALYZE=true pnpm build",
    "test:sith": "playwright test tests/sith-contrast.spec.ts",
    "test:a11y": "playwright test tests/a11y-matrix.spec.ts",
    "test:iphone-se": "playwright test tests/iphone-se.spec.ts",
    "test:e2e": "playwright test tests/e2e.spec.ts --project=e2e",
    "test:unit": "vitest --run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest --run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.8.5",
    "@iconify/react": "^6.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.7.0",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "negotiator": "^1.0.0",
    "next": "16.2.4",
    "next-intl": "^4.11.0",
    "next-mdx-remote": "^6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4",
    "shadcn": "^4.6.0",
    "shiki": "^4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "^1.9.4",
    "@iconify-json/logos": "^1.2.11",
    "@next/bundle-analyzer": "^16",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.5"
  }
}
